25,\"y\":12.5},{\"x\":26,\"y\":11},{\"x\":27,\"y\":9.5},{\"x\":28,\"y\":8},{\"x\":29,\"y\":6.5},{\"x\":30,\"y\":5},{\"x\":31,\"y\":3.5},{\"x\":32,\"y\":2},{\"x\":33,\"y\":0.5},{\"x\":34,\"y\":-1},{\"x\":35,\"y\":-2.5},{\"x\":36,\"y\":-4},{\"x\":37,\"y\":-5.5},{\"x\":38,\"y\":-7},{\"x\":39,\"y\":-8.5},{\"x\":40,\"y\":-10},{\"x\":41,\"y\":-11.5},{\"x\":42,\"y\":-13},{\"x\":43,\"y\":-14.5},{\"x\":44,\"y\":-16},{\"x\":45,\"y\":-17.5},{\"x\":46,\"y\":-19},{\"x\":47,\"y\":-20.5},{\"x\":48,\"y\":-22},{\"x\":49,\"y\":-23.5},{\"x\":50,\"y\":-25},{\"x\":51,\"y\":-26.5},{\"x\":52,\"y\":-28},{\"x\":53,\"y\":-29.5},{\"x\":54,\"y\":-31},{\"x\":55,\"y\":-32.5},{\"x\":56,\"y\":-34},{\"x\":57,\"y\":-35.5},{\"x\":58,\"y\":-37},{\"x\":59,\"y\":-38.5},{\"x\":60,\"y\":-40}],\"type\":\"spline\",\"name\":\"2Q + 3P = 100\",\"color\":\"red\",\"marker\":{\"enabled\":false}},{\"group\":\"group\",\"data\":[{\"x\":30,\"y\":5}],\"type\":\"scatter\",\"name\":\"Solución (30, 5)\",\"marker\":{\"symbol\":\"circle\",\"radius\":6,\"fillColor\":\"orange\"}},{\"group\":\"group\",\"data\":[{\"x\":0,\"y\":50,\"label\":\"Punto A1\",\"name\":\"Punto A1\"},{\"x\":33.33333333333334,\"y\":0,\"label\":\"Punto A2\",\"name\":\"Punto A2\"}],\"type\":\"scatter\",\"showInLegend\":false,\"marker\":{\"symbol\":\"diamond\",\"radius\":6,\"fillColor\":\"orange\"},\"dataLabels\":{\"enabled\":true,\"format\":\"{point.name}\"}},{\"group\":\"group\",\"data\":[{\"x\":0,\"y\":-55,\"label\":\"Punto B1\",\"name\":\"Punto B1\"},{\"x\":27.5,\"y\":0,\"label\":\"Punto B2\",\"name\":\"Punto B2\"}],\"type\":\"scatter\",\"showInLegend\":false,\"marker\":{\"symbol\":\"triangle\",\"radius\":6,\"fillColor\":\"orange\"},\"dataLabels\":{\"enabled\":true,\"format\":\"{point.name}\"}}],\"legend\":{\"enabled\":true},\"xAxis\":{\"plotLines\":[{\"value\":0,\"color\":\"darkgrey\",\"width\":2,\"zIndex\":3}]},\"tooltip\":{\"shared\":false}},\"theme\":{\"chart\":{\"backgroundColor\":\"transparent\"},\"colors\":[\"#7cb5ec\",\"#434348\",\"#90ed7d\",\"#f7a35c\",\"#8085e9\",\"#f15c80\",\"#e4d354\",\"#2b908f\",\"#f45b5b\",\"#91e8e1\"]},\"conf_opts\":{\"global\":{\"Date\":null,\"VMLRadialGradientURL\":\"http =//code.highcharts.com/list(version)/gfx/vml-radial-gradient.png\",\"canvasToolsURL\":\"http =//code.highcharts.com/list(version)/modules/canvas-tools.js\",\"getTimezoneOffset\":null,\"timezoneOffset\":0,\"useUTC\":true},\"lang\":{\"contextButtonTitle\":\"Chart context menu\",\"decimalPoint\":\".\",\"downloadCSV\":\"Download CSV\",\"downloadJPEG\":\"Download JPEG image\",\"downloadPDF\":\"Download PDF document\",\"downloadPNG\":\"Download PNG image\",\"downloadSVG\":\"Download SVG vector image\",\"downloadXLS\":\"Download XLS\",\"drillUpText\":\"◁ Back to {series.name}\",\"exitFullscreen\":\"Exit from full screen\",\"exportData\":{\"annotationHeader\":\"Annotations\",\"categoryDatetimeHeader\":\"DateTime\",\"categoryHeader\":\"Category\"},\"hideData\":\"Hide data table\",\"invalidDate\":null,\"loading\":\"Loading...\",\"months\":[\"January\",\"February\",\"March\",\"April\",\"May\",\"June\",\"July\",\"August\",\"September\",\"October\",\"November\",\"December\"],\"noData\":\"No data to display\",\"numericSymbolMagnitude\":1000,\"numericSymbols\":[\"k\",\"M\",\"G\",\"T\",\"P\",\"E\"],\"printChart\":\"Print chart\",\"resetZoom\":\"Reset zoom\",\"resetZoomTitle\":\"Reset zoom level 1:1\",\"shortMonths\":[\"Jan\",\"Feb\",\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Oct\",\"Nov\",\"Dec\"],\"shortWeekdays\":[\"Sat\",\"Sun\",\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\"],\"thousandsSep\":\" \",\"viewData\":\"View data table\",\"viewFullscreen\":\"View in full screen\",\"weekdays\":[\"Sunday\",\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\"]}},\"type\":\"chart\",\"fonts\":[],\"debug\":false},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n:::\n\n## Ejercicio 4.\n\n$$\n\\begin{align}\nx+y-z &= -1 \\tag{A}\\\\\\\\\n-x+2y-2z&=-5 \\tag{B}\\\\\\\\\n2x+3y+z&=12 \\tag{C}\\\\\\\\\n\\end{align}\n$$\n\n1)  Elegimos una ecuación y despejamos cualquiera de las incógnitas, en este ejemplo despejamos $x$ de la ecuación A\n\n$$\n\\begin{align}\nx+y-z &= -1 \\tag{A}\\\\\\\\\nx&=-1-y+z \\tag{A1}\n\\end{align}\n$$ 2) Sustituimos el valor de $x$ en la ecuación B\n\n$$\n\\begin{align}\n-x+2y-2z&=-5 \\tag{B}\\\\\\\\\n-(-1-y+z)+2y-2z&=-5 \\\\\\\\\n1+y-z+2y-2z&=-5 \\\\\\\\\n3y-3z&=-5-1 \\\\\\\\\n3(y-z)&=-6 \\\\\\\\\ny-z&=-\\frac{6}{3}=-2 \\\\\\\\\ny&=-2+z \\tag{B1}\n\\end{align}\n$$\n\nNoten como se redujo el número de incógnitas entre la ecuación A1 y B1, esto es un indicador importante de que estamos avanzando hacia la solución del sistema.\n\n3)  En la ecuación C, sustituimos los valores de $x$ e $y$ que obtuvimos en las ecuaciones A1 y B1\n\n$$\n\\begin{align}\n2x+3y+z&=12 \\tag{C}\\\\\\\\\n2(-1-y+z)+3(-2+z)+z&=12 \\\\\\\\\n-2-2y+2z-6+3z+z&=12 \\\\\\\\\n6z-2y&=12+8 \\tag{*} \\\\\\\\\n6z-2(-2+z)&=20 \\\\\\\\\n6z+4-2z&=20 \\\\\\\\\n4z&=20-4 \\\\\\\\\nz&=\\frac{16}{4}=4 \\tag{C1}\n\\end{align}\n$$\n\nEs posible que al sustituir obtengamos como resultado una ecuación con dos incógnitas, como en la ecuación marcada con (\\*). En estos casos hay que continuar sustituyendo, siempre y cuando conozcamos el valor de alguna de las incógnitas.\n\n4)  La ecuación C1 nos dio como resultado el valor de $z$, con él podemos obtener el valor de $y$ en la ecuación B1 y posteriormente podremos obtener el valor de $x$ en la ecuación A1.\n\n$$\n\\begin{align}\ny&=-2+z \\tag{B1} \\\\\ny&=-2+4=2 \\\\\\\\\nx&=-1-y+z \\tag{A1} \\\\\nx&=-1-2+4=1\n\\end{align}\n$$ **Solución**\n\n$$\n\\begin{align}\nx&=1 \\\\\ny&=2 \\\\\nz&=4\n\\end{align}\n$$\n\n## Ejercicio 5.\n\n$$\n\\begin{align}\n2x+3y+z &= 12 \\tag{A}\\\\\\\\\n-x+y-3z&=4 \\tag{B}\\\\\\\\\n14x+21y+7z&=84 \\tag{C}\\\\\\\\\n\\end{align}\n$$\n\nEste es un ejemplo de sistema que no tiene solución. Como se ha mencionado en clase, una de las formas para saberlo es identificando que una de las ecuaciones es múltiplo de otra. En este sistema, si multiplicamos la ecuación A por 7 obtenemos la ecuación C.\n\n$$\n\\begin{align}\n2x+3y+z &= 12 \\tag{A}\\\\\n7(2x+3y+z) &= 7(12)\\\\\n14x+21y+7z&=84\\\\\\\\\n\\end{align}\n$$\n\nTambién podemos hacer la operación inversa (división) en la ecuación C.\n\n$$\n\\begin{align}\n14x+21y+7z&=84 \\tag{C}\\\\\\\\\n\\frac{1}{7}(14x+21y+7z)&=\\frac{84}{7} \\\\\\\\\n2x+3y+z &= 12\n\\end{align}\n$$\n\nNo importa la operación que realicen o la ecuación que elijan para comprobar, lo importante es que **realicen la operación en ambos términos de la ecuación**.\n",
